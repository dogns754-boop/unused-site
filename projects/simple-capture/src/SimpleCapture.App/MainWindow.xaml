<Window x:Class="SimpleCapture.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="simple-capture" Width="420" Height="220"
        WindowStartupLocation="CenterScreen"
        FontFamily="Malgun Gothic">
    <StackPanel Margin="20" VerticalAlignment="Center">
        <TextBlock Text="보다 간단한 캡처 — 캡처·녹화·GIF·텍스트 추출을 한 창에서" FontSize="16" Margin="0,0,0,12" />
        <DockPanel>
            <Button x:Name="GreetButton" Content="인사" DockPanel.Dock="Right"
                    Padding="14,4" Margin="8,0,0,0" Click="GreetButton_Click" />
            <TextBox x:Name="NameBox" />
        </DockPanel>
        <TextBlock x:Name="Output" Margin="0,12,0,0" />
    </StackPanel>
</Window>
