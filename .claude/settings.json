{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(scripts/check.sh:*)",
      "Bash(scripts/status.sh:*)",
      "Bash(scripts/new-project.sh:*)",
      "Bash(bash scripts/check.sh:*)",
      "Bash(bash scripts/status.sh:*)",
      "Bash(bash scripts/new-project.sh:*)",
      "Bash(npm test:*)",
      "Bash(npm start:*)",
      "Bash(node --test:*)",
      "Bash(python3 -m unittest:*)",
      "Bash(python3 -m pytest:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ],
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Read(./**/secrets/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/status.sh\" --brief"
          }
        ]
      }
    ]
  }
}
