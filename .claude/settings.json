{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(scripts/check.sh:*)",
      "Bash(scripts/status.sh:*)",
      "Bash(scripts/new-project.sh:*)",
      "Bash(bash scripts/check.sh:*)",
      "Bash(bash scripts/status.sh:*)",
      "Bash(bash scripts/new-project.sh:*)",
      "Bash(npm test:*)",
      "Bash(npm start:*)",
      "Bash(node --test:*)",
      "Bash(python3 -m unittest:*)",
      "Bash(python3 -m pytest:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet run:*)",
      "Bash(scripts/setup.sh:*)",
      "Bash(bash scripts/setup.sh:*)",
      "mcp__context7",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(scripts/sync-check.sh:*)",
      "Bash(bash scripts/sync-check.sh:*)"
    ],
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Read(./**/secrets/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/setup.sh\"",
            "timeout": 300
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/status.sh\" --brief"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/sync-check.sh\"",
            "timeout": 20
          }
        ]
      }
    ]
  },
  "enableAllProjectMcpServers": true
}
